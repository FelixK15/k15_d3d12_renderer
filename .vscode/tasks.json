{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "windows": {
                "options": {
                    "cwd": "${workspaceFolder}"
                },
                "command": "k15_build_system.exe",
                "args": [
                   "--buildconfig",
                   "Debug"
                ],
                "problemMatcher": [
                    "$msCompile"
                ]
            },
            "presentation": {
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Release",
            "type": "shell",
            "windows": {
                "options": {
                    "cwd": "${workspaceFolder}"
                },
                "command": "k15_build_system.exe",
                "args": [
                   "--buildconfig",
                   "Release"
                ],
                "problemMatcher": [
                    "$msCompile"
                ]
            },
            "presentation": {
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}